#
# The applets are reached in process. Tenok has neither fork() nor exec(), so
# the shell calls them instead of starting them, and the standalone shell is
# what makes it look for the name among them first.
#
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_PREFER_APPLETS=y

#
# The shell
#
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_BASE=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y

#
# The line the shell reads. The history is kept short because it lives in the
# heap of a task with sixty four kilobytes of page memory behind it.
#
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=512
CONFIG_FEATURE_EDITING_HISTORY=15
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y

#
# Files
#
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CMP=y
CONFIG_CP=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TOUCH=y

#
# Text
#
CONFIG_CUT=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_HD=y
CONFIG_HEXDUMP=y
CONFIG_OD=y
CONFIG_PRINTF=y
CONFIG_TEE=y
CONFIG_TR=y
CONFIG_WC=y

#
# Paths
#
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PWD=y
CONFIG_WHICH=y

#
# The rest
#
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TRUE=y
CONFIG_UNAME=y
CONFIG_UNAME_OSNAME="Tenok"
